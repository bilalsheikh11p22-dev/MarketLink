# Base URL of the MarketLink API (must end in /api). Image uploads are served from the same origin.
VITE_API_URL=http://localhost:5000/api
# Optional: serve /uploads from a different origin (defaults to the API origin)
# VITE_UPLOADS_URL=
# Optional: Google Sign-In (same client ID as the server)
# VITE_GOOGLE_CLIENT_ID=
# Optional: contact details shown on the About/Contact pages. Leave blank to hide them.
# VITE_SUPPORT_EMAIL=
# VITE_SUPPORT_PHONE=
# VITE_SUPPORT_HOURS=
# VITE_SUPPORT_ADDRESS=
