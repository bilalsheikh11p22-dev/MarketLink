PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/marketlink
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Email (used for the "forgot password" OTP) ---
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Brevo, etc).
# If these are left unset, the server logs the OTP to the console instead of
# emailing it, so the flow can still be tested locally.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=MarketLink <your_email@gmail.com>

# --- Google Sign-In ---
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:5173 (and your production domain) under
# "Authorized JavaScript origins". Use the same value here and in
# client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Hardening / deployment ---
# Comma-separated allowed browser origins are taken from CLIENT_URL (set it to your deployed frontend URL).
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx) so rate limiting sees real client IPs.
# TRUST_PROXY=1
RATE_LIMIT_MAX=600
# Directory for uploaded images (default: server/uploads). Point at a persistent disk in production.
# UPLOAD_DIR=
# Set to true to refuse accidental seeding in production unless explicitly allowed.
# ALLOW_SEED=false
# Disable the background pickup-reminder job (e.g. on extra replicas).
# DISABLE_JOBS=false

# --- Optional AI assistant provider (the assistants work from database data without one) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=
